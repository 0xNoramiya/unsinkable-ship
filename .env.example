# TrueFoundry AI Gateway credentials.
# Get yours from: https://<your-tenant>.truefoundry.cloud → Access → Personal Access Tokens
TFY_API_KEY=your-truefoundry-pat-here
TFY_HOST=https://your-tenant.truefoundry.cloud

# Derived gateway base URL (OpenAI-compatible endpoint)
# Default: $TFY_HOST/api/llm
TFY_GATEWAY_BASE_URL=https://your-tenant.truefoundry.cloud/api/llm

# Virtual Model name configured in TrueFoundry console (provider-prefix/model)
UNSINKABLE_DEFAULT_MODEL=resilient-chat/resilient-chat

# Dashboard event sink — where the shim emits OTel-ish events
UNSINKABLE_DASHBOARD_URL=http://127.0.0.1:8765
